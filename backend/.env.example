DYNNO_APP_ENV=production
DYNNO_APP_NAME=Dynno Customs API
DYNNO_APP_VERSION=0.1.0
DYNNO_API_PREFIX=/api

# Use PostgreSQL for production/pilot deployments.
DYNNO_DATABASE_URL=postgresql+psycopg://dynno_customs:change-me@postgres:5432/dynno_customs
DYNNO_DATABASE_ECHO=false
DYNNO_AUTH_TOKEN_TTL_HOURS=168
DYNNO_AUTH_OPEN_REGISTRATION=false

# Comma-separated JSON-style list parsed by pydantic-settings.
DYNNO_ALLOWED_ORIGINS=["https://dynno.example.com"]

# Store runtime data on persistent volumes in production.
DYNNO_UPLOADS_DIR=/var/lib/dynno/uploads
DYNNO_OCR_TEMP_DIR=/var/lib/dynno/tmp/ocr
DYNNO_OCR_OUTPUT_DIR=/var/lib/dynno/storage/ocr

DYNNO_TESSERACT_CMD=tesseract
DYNNO_OCR_PROVIDER=tesseract
DYNNO_OCR_LANGS=eng+rus
DYNNO_OCR_PDF_DPI=300
