{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynnocustoms.local/schemas/validation-result.schema.json",
  "title": "Validation Result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rule_code": {
      "type": "string",
      "pattern": "^R\\d{3}$"
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/severity"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/validationStatus"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/documentType"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "observed_values": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "array",
          "object"
        ]
      }
    },
    "expected_values": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "array",
          "object"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "rule_code",
    "severity",
    "status",
    "message",
    "documents",
    "fields",
    "observed_values",
    "evidence"
  ]
}
